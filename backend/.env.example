# Variable reference only: Spring Boot does NOT load .env automatically.
# Set variables in your terminal or IDE run configuration.
# All three database variables are required. Keep passwords out of the JDBC URL.
STUDYMATE_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/studymate
STUDYMATE_DATABASE_USERNAME=studymate
STUDYMATE_DATABASE_PASSWORD=

# Optional: safe local defaults shown here.
STUDYMATE_SERVER_ADDRESS=127.0.0.1
STUDYMATE_SERVER_PORT=8080

# Registration is closed by default, including local development.
# Explicit opt-in for local testing; CSRF is always required.
STUDYMATE_REGISTRATION_ENABLED=false

# Persistent worker: one active handler per application process. No production job types yet.
STUDYMATE_JOBS_ENABLED=true
STUDYMATE_JOBS_POLL_INTERVAL_MS=1000
STUDYMATE_JOBS_HEARTBEAT_INTERVAL_MS=5000
STUDYMATE_JOBS_LEASE_SECONDS=30
STUDYMATE_JOBS_EXECUTION_TIMEOUT_SECONDS=120
STUDYMATE_JOBS_MAX_ATTEMPTS=3
STUDYMATE_JOBS_RETRY_DELAY_SECONDS=2
STUDYMATE_JOBS_MAX_RETRY_DELAY_SECONDS=60
# Heartbeat * 3 <= lease; timeout >= lease; max retry delay >= initial delay.
# Settings are bounded/validated on startup. Existing jobs keep their execution/retry settings.

# Only for HTTP development on loopback. Default profile requires HTTPS (Secure cookie).
# The local profile does not enable registration automatically.
SPRING_PROFILES_ACTIVE=local

# Required only for: mvnw -Ppostgres-it verify
# Use a separate disposable PostgreSQL database, never the application database.
STUDYMATE_TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/studymate_test
STUDYMATE_TEST_DATABASE_USERNAME=studymate_test
STUDYMATE_TEST_DATABASE_PASSWORD=

# Sessions: 30-minute idle timeout, 12-hour absolute lifetime after login; PostgreSQL storage.
# R2, PDF limits and AI settings will be introduced at their own stages.
